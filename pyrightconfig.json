{
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportDuplicateImport": "error",
  "reportUnnecessaryImport": "warning",
  "include": ["src", "tests"],
  "exclude": ["**/node_modules", "**/__pycache__", "**/.git"],
  "python": {
    "version": "3.12"
  },
  "typeCheckingMode": "basic"
}
